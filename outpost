#!/usr/bin/env bash
# Outpost - client mission workspace tool. Needs only bash + git (git-crypt for private notes).
set -euo pipefail

VERSION="0.2.0"

# Resolve the real location of this script (follows symlinks).
src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
  d=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$d/$src" ;; esac
done
OUTPOST_HOME=$(cd -P "$(dirname "$src")" && pwd)
TEMPLATES="$OUTPOST_HOME/templates"

CREATED=()   # absolute paths of files created during this run
UPDATED=()   # absolute paths of managed files rewritten during this run
WARNINGS=()
CMD=init     # init or update (only changes the messages)

VERBOSE=0
DEFAULT_NOTES=""

# Colors only on a real terminal (NO_COLOR respected); emoji only on a UTF-8 locale.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
  B=$'\033[1m'; D=$'\033[2m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; N=$'\033[0m'
else
  B=""; D=""; G=""; Y=""; R=""; N=""
fi
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
  *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*)
    I_START="🛰 "; I_SKILL="🧩"; I_SHELL="🐚"; I_DIR="📁"; I_NOTES="📝"; I_OK="✔"; I_WARN="⚠"; I_DOT="·"; I_DONE="✅"; I_NEXT="👉" ;;
  *)
    I_START=">>"; I_SKILL="[s]"; I_SHELL="[p]"; I_DIR="[+]"; I_NOTES="[n]"; I_OK="ok"; I_WARN="!!"; I_DOT="-"; I_DONE="OK"; I_NEXT="->" ;;
esac

say()  { printf '%s\n' "$*"; }
ok()   { printf '   %s%s%s %s\n' "$G" "$I_OK" "$N" "$*"; }
warn() { WARNINGS+=("$*"); printf '   %s%s %s%s\n' "$Y" "$I_WARN" "$*" "$N"; }
die()  { printf '%soutpost: %s%s\n' "$R" "$*" "$N" >&2; exit 1; }

# summary <label> <count_before>: one line per folder, files listed only with --verbose.
summary() {
  local n=$(( ${#CREATED[@]} - $2 )) f
  if [ "$n" -eq 0 ]; then
    printf '%s %s%-13s%s %sup to date%s\n' "$I_DIR" "$B" "$1" "$N" "$D" "$N"
  else
    printf '%s %s%-13s%s %s+%d file(s)%s\n' "$I_DIR" "$B" "$1" "$N" "$G" "$n" "$N"
    if [ "$VERBOSE" = 1 ]; then
      for f in "${CREATED[@]:$2}"; do printf '     %s%s%s\n' "$D" "${f#"$MISSION_ROOT"/}" "$N"; done
    fi
  fi
}

usage() {
  cat <<EOF
Outpost $VERSION

Usage:
  outpost init [path] [--agent copilot|claude] [--dry-run]
                        create the mission layout (default: current directory,
                        agent: copilot, or the one saved by a previous init)
                        --dry-run: path is a folder name created under
                        <outpost clone>/.dry-run/ (gitignored), default: mission
                        --verbose: list every created file
                        --no-skill: do not install the note skill for the agent
                        --no-profile: do not touch the shell profile (OUTPOST_NOTES, outpost, n, np)
                        (dry-run installs it under <mission>/.fake-home)
  outpost update [path] [--dry-run] [--no-fetch]
                        move this clone to the latest release tag, then refresh the
                        mission (default: the mission around the current folder):
                        _outpost/ is regenerated, your folders only get additions
                        --no-fetch: keep the tool as it is, only refresh the mission
                        also takes --verbose, --no-skill, --no-profile
  outpost note [--private] [--tags "type/idea topic/x"]
                        append a note (text on stdin) to today's daily note
  outpost help          show this help
EOF
}

# copy_tree <src_dir> <dest_dir> [skip_private]
# Copies every file that does not already exist at the destination. Never overwrites.
copy_tree() {
  local from="$1" to="$2" skip_private="${3:-}" rel
  while IFS= read -r rel; do
    rel="${rel#./}"
    if [ -n "$skip_private" ]; then
      case "$rel" in *.private.md) continue ;; esac
    fi
    if [ -e "$to/$rel" ]; then
      continue
    fi
    mkdir -p "$(dirname "$to/$rel")"
    cp "$from/$rel" "$to/$rel"
    CREATED+=("$to/$rel")
  done < <(cd "$from" && find . -type f | LC_ALL=C sort)
}

write_if_missing() { # <path> ; content on stdin
  if [ -e "$1" ]; then cat >/dev/null; return 0; fi
  mkdir -p "$(dirname "$1")"
  cat > "$1"
  CREATED+=("$1")
}

init_notes() {
  local notes="$1" have_crypt=0 gitdir
  command -v git-crypt >/dev/null 2>&1 && have_crypt=1

  mkdir -p "$notes"

  # 1. git repo (never reuse a parent repo: notes/ gets its own).
  if [ ! -d "$notes/.git" ]; then
    git init -q "$notes"
    ok "git repository initialised"
  else
    ok "git repository"
  fi
  gitdir=$(git -C "$notes" rev-parse --absolute-git-dir)

  # 2. pre-commit hook (installed first so nothing private slips in later). It is a relay to
  #    _outpost/notes/hooks/pre-commit, so the real check is refreshed with _outpost/.
  local hook="$gitdir/hooks/pre-commit"
  mkdir -p "$gitdir/hooks"
  if [ ! -e "$hook" ]; then
    cp "$TEMPLATES/hooks/pre-commit" "$hook"; chmod +x "$hook"
    ok "pre-commit hook installed (blocks unencrypted *.private.md)"
  elif grep -q '^# outpost: refuse to commit a \*.private.md' "$hook"; then
    # Hook from before _outpost/ (the full check, copied in place): switch to the relay.
    cp "$TEMPLATES/hooks/pre-commit" "$hook"; chmod +x "$hook"; UPDATED+=("$hook")
    ok "pre-commit hook updated (now runs _outpost/notes/hooks/pre-commit)"
  elif ! cmp -s "$TEMPLATES/hooks/pre-commit" "$hook"; then
    warn "a different pre-commit hook already exists in $hook; private-file check NOT installed"
  else
    ok "pre-commit hook"
  fi

  # 3. git-crypt, only on a repo that has no history yet.
  if [ ! -d "$gitdir/git-crypt/keys" ]; then
    # Safe to init as long as no private file was ever committed.
    if [ "$have_crypt" = 1 ] && [ -z "$(git -C "$notes" ls-files '*.private.md')" ]; then
      (cd "$notes" && git-crypt init >/dev/null)
      ok "git-crypt initialised"
    elif [ "$have_crypt" = 0 ]; then
      warn "git-crypt not found: private files skipped and blocked. Install it, then re-run 'outpost init'"
    else
      warn "this repo has history but no git-crypt key: run 'git-crypt unlock <keyfile>'"
    fi
  fi

  if [ -d "$gitdir/git-crypt/keys" ] && [ "$have_crypt" = 1 ]; then
    ok "git-crypt ready"
  fi

  # 4. .gitattributes, committed BEFORE any private file exists.
  write_if_missing "$notes/.gitattributes" <<'EOF'
*.private.md filter=git-crypt diff=git-crypt
EOF
  if [ -f "$notes/.gitattributes" ] && ! git -C "$notes" cat-file -e HEAD:.gitattributes 2>/dev/null; then
    git -C "$notes" add .gitattributes
    git -C "$notes" commit -q -m "outpost: git-crypt attributes" -- .gitattributes \
      || warn "could not commit .gitattributes (git user.name/user.email set?)"
  fi

  # 5. skeleton: never overwrites. Private templates only if git-crypt is ready.
  local skip=""
  [ -d "$gitdir/git-crypt/keys" ] || skip=1
  local before=${#CREATED[@]}
  copy_tree "$TEMPLATES/notes" "$notes" "$skip"

  # 6. Foam daily-note template, generated from _outpost's daily.md (single source, so `n`
  #    and Foam always create the same daily note). Foam only reads it from .foam/templates/.
  local foam=".foam/templates/daily-note.md" tmp
  tmp=$(mktemp)
  sed 's/{{date}}/${FOAM_DATE_YEAR}-${FOAM_DATE_MONTH}-${FOAM_DATE_DATE}/g' \
    "$(dirname "$notes")/_outpost/notes/templates/daily.md" > "$tmp"
  if [ ! -e "$notes/$foam" ]; then
    mkdir -p "$notes/.foam/templates"; cp "$tmp" "$notes/$foam"; CREATED+=("$notes/$foam")
  elif ! cmp -s "$tmp" "$notes/$foam"; then
    cp "$tmp" "$notes/$foam"; UPDATED+=("$notes/$foam")
  fi
  rm -f "$tmp"

  # 7. commit the skeleton files that are not tracked yet, and the Foam template when it
  #    changed. Only those files are considered, so a failed commit on a previous run heals
  #    itself and your own files (or your edits to skeleton files) are never swept in.
  local rel pending=()
  while IFS= read -r rel; do
    rel="${rel#./}"
    [ -z "$skip" ] || case "$rel" in *.private.md) continue ;; esac
    [ -f "$notes/$rel" ] || continue
    if git -C "$notes" cat-file -e "HEAD:$rel" 2>/dev/null; then
      [ "$rel" = "$foam" ] || continue
      git -C "$notes" diff --quiet HEAD -- "$rel" && continue
    fi
    git -C "$notes" add -- "$rel"; pending+=("$rel")
  done < <({ (cd "$TEMPLATES/notes" && find . -type f); echo "$foam"; } | LC_ALL=C sort)
  if [ "${#pending[@]}" -gt 0 ]; then
    git -C "$notes" commit -q -m "outpost: notes v$VERSION" -- "${pending[@]}" \
      || warn "could not commit the notes skeleton (git user.name/user.email set?)"
  fi
}

# sync_outpost <mission_root>: regenerate <root>/_outpost from templates/_outpost, as a whole.
# _outpost/ belongs to Outpost: it is rebuilt next to the current one, then swapped in.
sync_outpost() {
  local root="$1" dest="$1/_outpost" new="$1/_outpost.new" bin nd qbin f
  rm -rf "$new"
  mkdir -p "$new"
  cp -R "$TEMPLATES/_outpost/." "$new/"
  printf '%s\n' "$VERSION" > "$new/VERSION"
  # The note skill, with this clone's binary and this mission's notes folder baked in.
  bin="$OUTPOST_HOME/outpost"; bin=${bin//\\/\\\\}; bin=${bin//&/\\&}; bin=${bin//|/\\|}
  nd="$root/notes"; nd=${nd//\\/\\\\}; nd=${nd//&/\\&}; nd=${nd//|/\\|}
  f="$new/skills/outpost-note/SKILL.md"
  sed "s|{{OUTPOST_BIN}}|$bin|g; s|{{NOTES_DIR}}|$nd|g" "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  # n / np, sourced by the shell profile: this clone's binary, single-quoted for the shell.
  qbin="'${OUTPOST_HOME//\'/\'\\\'\'}/outpost'"
  qbin=${qbin//\\/\\\\}; qbin=${qbin//&/\\&}; qbin=${qbin//|/\\|}
  f="$new/shell/commands.sh"
  sed "s|{{OUTPOST_BIN_QUOTED}}|$qbin|g" "$f" > "$f.tmp" && mv "$f.tmp" "$f"

  if [ ! -d "$dest" ]; then
    mv "$new" "$dest"; CREATED+=("$dest")
    ok "_outpost/ created (v$VERSION)"
  elif diff -r "$dest" "$new" >/dev/null 2>&1; then
    rm -rf "$new"
    ok "_outpost/ up to date (v$VERSION)"
  else
    rm -rf "$dest"; mv "$new" "$dest"; UPDATED+=("$dest")
    ok "_outpost/ updated to v$VERSION"
  fi
}

# warn_legacy <notes_dir>: files from before _outpost/ that Outpost no longer uses or updates.
# They are yours, so they are only reported, never changed or removed.
warn_legacy() {
  local notes="$1" f
  if [ -d "$notes/templates" ]; then
    warn "notes/templates/ is no longer used: templates now live in _outpost/notes/templates/ (you can delete it)"
  fi
  for f in AGENTS.md CLAUDE.md; do
    if [ -f "$notes/$f" ] && ! grep -q '_outpost/notes/AGENTS.md' "$notes/$f"; then
      warn "notes/$f predates _outpost/ and will not get convention updates: make it point to ../_outpost/notes/AGENTS.md (see $TEMPLATES/notes/AGENTS.md)"
    fi
  done
}

# conf_get <mission_root> <key>: value saved in <root>/.outpost.conf, empty if none.
conf_get() {
  [ -f "$1/.outpost.conf" ] || return 0
  sed -n "s/^$2=//p" "$1/.outpost.conf" | head -n 1
}

cmd_init() {
  local target="" agent="" dry=0 skill="" profile="" root conf
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --agent)   [ "$#" -ge 2 ] || die "--agent needs a value (copilot|claude)"; agent="$2"; shift 2 ;;
      --agent=*) agent="${1#--agent=}"; shift ;;
      --dry-run) dry=1; shift ;;
      --verbose) VERBOSE=1; shift ;;
      --no-skill) skill=0; shift ;;
      --no-profile) profile=0; shift ;;
      -*)        die "unknown option: $1" ;;
      *)         target="$1"; shift ;;
    esac
  done
  case "$agent" in ""|copilot|claude) ;; *) die "unknown agent '$agent' (supported: copilot, claude)" ;; esac
  if [ "$dry" = 1 ]; then
    # The path is a folder NAME under .dry-run/ (gitignored), never a real location.
    target="${target:-mission}"
    case "$target" in
      /*|..|../*|*/..|*/../*) die "--dry-run takes a relative folder name (created under .dry-run/), got '$target'" ;;
    esac
    target="$OUTPOST_HOME/.dry-run/$target"
  else
    target="${target:-.}"
  fi
  mkdir -p "$target"
  root=$(cd "$target" && pwd -P)
  MISSION_ROOT="$root"
  trap '[ "$?" -eq 0 ] || rmdir "$MISSION_ROOT" 2>/dev/null || true' EXIT
  case "$root/" in
    "$OUTPOST_HOME/.dry-run/"*) [ "$dry" = 1 ] || die "$OUTPOST_HOME/.dry-run is reserved for --dry-run" ;;
    "$OUTPOST_HOME"/*) die "the mission root must be outside the Outpost clone ($OUTPOST_HOME)" ;;
  esac
  case "$OUTPOST_HOME/" in
    "$root"/*) die "the Outpost clone must be outside the mission root ($root)" ;;
  esac
  # _outpost/ is replaced as a whole: never take over a folder Outpost did not create.
  if [ -e "$root/_outpost" ] && [ ! -f "$root/_outpost/VERSION" ]; then
    die "$root/_outpost exists but is not managed by outpost (no VERSION file): move it away first"
  fi

  # Choices are saved in .outpost.conf (outside the client git) so that re-runs and
  # `outpost update` keep them. Explicit flag wins, then the saved choice, then the default.
  agent="${agent:-$(conf_get "$root" agent)}"; agent="${agent:-copilot}"
  skill="${skill:-$(conf_get "$root" skill)}"; skill="${skill:-1}"
  profile="${profile:-$(conf_get "$root" profile)}"; profile="${profile:-1}"
  case "$agent" in copilot|claude) ;; *) die "invalid agent '$agent' in $root/.outpost.conf" ;; esac
  conf=$(printf 'agent=%s\n' "$agent"; [ "$skill" = 1 ] || echo "skill=0"; [ "$profile" = 1 ] || echo "profile=0")
  [ "$conf" = "$(cat "$root/.outpost.conf" 2>/dev/null)" ] || printf '%s\n' "$conf" > "$root/.outpost.conf"

  local tag=""
  [ "$dry" = 1 ] && tag=" ${Y}[dry-run]${N}"
  say "${I_START} ${B}Outpost $VERSION${N} ${D}$CMD${N}$tag"
  say "   ${D}mission root${N}  $root"
  say "   ${D}agent${N}         $agent"
  say ""
  local d n
  for d in workspace resources outbox sandbox; do
    n=${#CREATED[@]}
    mkdir -p "$root/$d"
    copy_tree "$TEMPLATES/$d" "$root/$d"
    summary "$d/" "$n"
  done
  say "$I_DIR ${B}_outpost/${N} ${D}(managed by outpost, regenerated as a whole)${N}"
  sync_outpost "$root"
  n=${#CREATED[@]}
  say "$I_NOTES ${B}notes/${N}"
  init_notes "$root/notes"
  warn_legacy "$root/notes"
  summary "notes files" "$n"
  if [ "$skill" = 1 ]; then
    say "$I_SKILL ${B}note skill${N} ${D}(outside the mission root, in your user folder)${N}"
    if [ "$dry" = 1 ]; then
      install_skill "$agent" "$root/.fake-home" "$root"
    else
      install_skill "$agent" "$HOME" "$root"
    fi
  fi

  if [ "$profile" = 1 ]; then
    say "$I_SHELL ${B}shell profile${N} ${D}(outside the mission root, in your home)${N}"
    if [ "$dry" = 1 ]; then
      install_profile "$root/.fake-home" "$root"
    else
      install_profile "$HOME" "$root"
    fi
  fi

  say ""
  if [ "${#CREATED[@]}" -eq 0 ] && [ "${#UPDATED[@]}" -eq 0 ]; then
    say "$I_DONE ${B}Nothing to do${N}: layout already complete."
  elif [ "${#UPDATED[@]}" -eq 0 ]; then
    say "$I_DONE ${B}Done${N}: ${#CREATED[@]} file(s) created."
  else
    say "$I_DONE ${B}Done${N}: ${#CREATED[@]} created, ${#UPDATED[@]} managed item(s) updated."
  fi
  [ "${#WARNINGS[@]}" -eq 0 ] || say "$Y$I_WARN ${#WARNINGS[@]} warning(s), see above$N"
  [ "$CMD" = init ] || return 0
  local step=0
  say ""
  say "${I_NEXT} ${B}Next steps${N}"
  if [ -n "$PROFILE_RC" ]; then
    step=$((step + 1)); say "  $step. Open a new terminal (or: source $PROFILE_RC) to get OUTPOST_NOTES, outpost, n and np."
  else
    step=$((step + 1)); say "  $step. Add to your shell profile:"
    if [ -n "$PROFILE_MANUAL" ]; then
      printf '%s\n' "$PROFILE_MANUAL" | sed 's/^/       /'
    else
      say "       export OUTPOST_NOTES=\"$root/notes\""
      say "       source \"$root/_outpost/shell/commands.sh\""
    fi
  fi
  cat <<TXT
  $((step + 1)). Back up the git-crypt key OUTSIDE the repo, then delete the export:
       cd "$root/notes" && git-crypt export-key /tmp/notes.key
       (copy it to your password manager, then: rm /tmp/notes.key)
  $((step + 2)). Friday review (manual): open your agent in notes/ and have it follow
       $root/_outpost/prompts/weekly-review.md
  $((step + 3)). Push notes/ to a private repo of the client git, once security confirms
     that encrypted content is accepted.
TXT
}

# install_skill <agent> <home> <mission_root>: copies the note skill rendered in
# <root>/_outpost/skills/ to where the agent looks for it (same SKILL.md for both agents).
# The file is owned by Outpost only while it carries the "managed by outpost" marker.
install_skill() {
  local agent="$1" base="$2" root="$3" dir rel src shown
  case "$agent" in
    claude)  rel=".claude/skills/outpost-note" ;;
    copilot) rel=".copilot/skills/outpost-note" ;;
  esac
  dir="$base/$rel"
  shown="${dir/#"$HOME"/\~}"
  src="$root/_outpost/skills/outpost-note/SKILL.md"
  if [ ! -e "$dir/SKILL.md" ]; then
    mkdir -p "$dir"; cp "$src" "$dir/SKILL.md"
    ok "note skill installed: $shown"
  elif ! grep -q 'managed by outpost' "$dir/SKILL.md"; then
    warn "$shown/SKILL.md exists and is not managed by outpost: left untouched"
  elif ! cmp -s "$src" "$dir/SKILL.md"; then
    cp "$src" "$dir/SKILL.md"
    ok "note skill updated: $shown"
  else
    ok "note skill: $shown"
  fi
}

# install_profile <home> <mission_root>: managed block in the shell profile (OUTPOST_NOTES, and
# outpost, n and np from <root>/_outpost/shell/commands.sh).
# Only the lines between the two markers belong to Outpost; the rest of the file is untouched.
PROFILE_RC=""      # profile file handled by this run (empty if unsupported)
PROFILE_MANUAL=""  # lines to add by hand when the shell is not supported
install_profile() {
  local base="$1" root="$2" notes_dir="$2/notes" sh rc shown q_notes q_src line inblock=0 found=0 tmp
  local begin='# >>> outpost >>> (managed by outpost: re-running init rewrites this block)'
  local end='# <<< outpost <<<'
  q_notes="'${notes_dir//\'/\'\\\'\'}'"
  q_src="'${root//\'/\'\\\'\'}/_outpost/shell/commands.sh'"
  PROFILE_MANUAL="export OUTPOST_NOTES=$q_notes
source $q_src"

  sh="${SHELL##*/}"
  case "$sh" in
    zsh)  rc="$base/.zshrc" ;;
    bash) if [ "$(uname)" = Darwin ]; then rc="$base/.bash_profile"; else rc="$base/.bashrc"; fi ;;
    *)    warn "shell '${sh:-unknown}' is not supported (bash or zsh): add these lines to your profile yourself"
          return 0 ;;
  esac
  shown="${rc/#"$HOME"/\~}"

  tmp=$(mktemp)
  if [ -f "$rc" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      if [ "$inblock" = 0 ] && [ "${line:0:14}" = "# >>> outpost " ]; then
        inblock=1; found=1
        printf '%s\n%s\n%s\n%s\n' "$begin" "export OUTPOST_NOTES=$q_notes" "source $q_src" "$end" >> "$tmp"
      elif [ "$inblock" = 1 ]; then
        [ "$line" = "$end" ] && inblock=0
      else
        printf '%s\n' "$line" >> "$tmp"
      fi
    done < "$rc"
    if [ "$inblock" = 1 ]; then
      rm -f "$tmp"; warn "$shown has an unterminated outpost block: left untouched"; return 0
    fi
  fi
  if [ "$found" = 0 ]; then
    [ ! -s "$tmp" ] || [ -z "$(tail -n1 "$tmp")" ] || printf '\n' >> "$tmp"
    printf '%s\n%s\n%s\n%s\n' "$begin" "export OUTPOST_NOTES=$q_notes" "source $q_src" "$end" >> "$tmp"
  fi

  PROFILE_RC="$shown"
  if [ ! -f "$rc" ]; then
    mkdir -p "$(dirname "$rc")"; cat "$tmp" > "$rc"; ok "shell profile created: $shown (OUTPOST_NOTES, outpost, n, np)"
  elif ! cmp -s "$tmp" "$rc"; then
    cat "$tmp" > "$rc"
    if [ "$found" = 1 ]; then ok "shell profile updated: $shown (OUTPOST_NOTES, outpost, n, np)"; else ok "shell profile: block added to $shown (OUTPOST_NOTES, outpost, n, np)"; fi
  else
    ok "shell profile: $shown"
  fi
  rm -f "$tmp"
}

# --- outpost note -----------------------------------------------------------

# Nearest mission above $PWD (a folder holding .outpost.conf and notes/), else $OUTPOST_NOTES,
# else the notes folder baked into the skill at install time (DEFAULT_NOTES).
find_notes_dir() {
  local d="$PWD"
  while :; do
    if [ -f "$d/.outpost.conf" ] && [ -d "$d/notes" ]; then printf '%s\n' "$d/notes"; return 0; fi
    [ "$d" = "/" ] && break
    d=$(dirname "$d")
  done
  if [ -n "${OUTPOST_NOTES:-}" ] && [ -d "$OUTPOST_NOTES" ]; then printf '%s\n' "$OUTPOST_NOTES"; return 0; fi
  if [ -n "${DEFAULT_NOTES:-}" ] && [ -d "$DEFAULT_NOTES" ]; then printf '%s\n' "$DEFAULT_NOTES"; return 0; fi
  return 1
}

# fences_balanced: reads text on stdin; fails if a ``` or ~~~ block is left open.
fences_balanced() {
  local line t c n rest open_c="" open_n=0
  while IFS= read -r line || [ -n "$line" ]; do
    t="${line#"${line%%[![:space:]]*}"}"
    case "$t" in '```'*) c='`' ;; '~~~'*) c='~' ;; *) continue ;; esac
    n=0; rest="$t"
    while [ "${rest:0:1}" = "$c" ]; do n=$((n + 1)); rest="${rest:1}"; done
    if [ -z "$open_c" ]; then
      # An inline ```code``` span on one line is not a fence.
      if [ "$c" = '`' ]; then case "$rest" in *'`'*) continue ;; esac; fi
      open_c="$c"; open_n=$n
    elif [ "$c" = "$open_c" ] && [ "$n" -ge "$open_n" ] && [ -z "${rest//[[:space:]]/}" ]; then
      open_c=""
    fi
  done
  [ -z "$open_c" ]
}

# make_tags "type/idea, topic/x": keeps letters, digits, _ - /, prefixes each with #.
make_tags() {
  local out="" t
  set -f
  for t in $1; do
    t="${t#\#}"
    t=$(printf '%s' "$t" | sed 's|[^[:alnum:]_/-]|-|g; s|--*|-|g; s|^[-/]*||; s|[-/]*$||')
    [ -n "$t" ] && out="$out #$t"
  done
  set +f
  printf '%s' "${out# }"
}

cmd_note() {
  local private="" tags="" body="" notes d hm suffix file tpl gitdir lastnb first
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --private) private=1; shift ;;
      --tags)    [ "$#" -ge 2 ] || die "--tags needs a value"; tags="$2"; shift 2 ;;
      --tags=*)  tags="${1#--tags=}"; shift ;;
      --default-notes) [ "$#" -ge 2 ] || die "--default-notes needs a folder"; DEFAULT_NOTES="$2"; shift 2 ;;
      -*)        die "unknown option: $1" ;;
      *)         body="${body:+$body }$1"; shift ;;
    esac
  done
  if [ -z "$body" ]; then
    [ ! -t 0 ] || die "usage: outpost note [--private] [--tags \"type/idea topic/x\"] < text"
    body=$(cat)
  fi

  # Normalize: no CR, no trailing spaces, no leading blank lines.
  body=$(printf '%s\n' "$body" | sed $'s/\r$//; s/[[:space:]]*$//')
  body="${body#"${body%%[![:space:]]*}"}"
  [ -n "$body" ] || die "empty note"
  case "$body" in
    *'<!-- note'*|*'<!-- /note'*) die "the text must not contain a note marker (<!-- note / <!-- /note -->)" ;;
  esac
  fences_balanced <<<"$body" || die "unclosed code fence (\`\`\` or ~~~) in the text"

  notes=$(find_notes_dir) || die "no mission found from $PWD: run inside a mission folder, set OUTPOST_NOTES, or re-run 'outpost init' to refresh the skill"
  suffix=""
  if [ -n "$private" ]; then
    suffix=".private"
    gitdir=$(git -C "$notes" rev-parse --absolute-git-dir 2>/dev/null) || die "notes/ is not a git repository"
    [ -d "$gitdir/git-crypt/keys" ] || die "git-crypt is not ready (not initialised or locked): refusing to write a private note"
  fi

  d="${OUTPOST_DATE:-$(date +%F)}"; hm="${OUTPOST_TIME:-$(date +%H:%M)}"
  file="$notes/daily/$d$suffix.md"
  mkdir -p "$notes/daily"
  if [ ! -f "$file" ]; then
    # Managed template first; a mission from before _outpost/ still has its own copy.
    tpl="$(dirname "$notes")/_outpost/notes/templates/daily$suffix.md"
    [ -f "$tpl" ] || tpl="$notes/templates/daily$suffix.md"
    if [ -f "$tpl" ]; then
      sed "s/{{date}}/$d/g" "$tpl" > "$file"
    else
      printf '# %s%s\n\n' "$d" "${private:+ (private)}" > "$file"
    fi
  fi

  # Separator logic: exactly one --- between notes, always after a blank line.
  [ -z "$(tail -c1 "$file")" ] || printf '\n' >> "$file"
  [ -z "$(tail -n1 "$file" | tr -d '[:space:]')" ] || printf '\n' >> "$file"
  lastnb=$(grep -v '^[[:space:]]*$' "$file" | tail -n 1 || true)
  [ "$lastnb" = "---" ] || printf -- '---\n\n' >> "$file"

  tags=$(make_tags "$tags")
  first="${body%%$'\n'*}"
  {
    printf '<!-- note %s -->\n' "$hm"
    # A first line that is itself block syntax keeps the time on its own line.
    if printf '%s' "$first" | grep -Eq '^(```|~~~|#|[-*+>]|[0-9]+[.)]|\|)'; then
      printf '**%s**\n\n%s\n' "$hm" "$body"
    else
      printf '**%s** · %s\n' "$hm" "$body"
    fi
    [ -z "$tags" ] || printf '\n%s\n' "$tags"
    printf '<!-- /note -->\n\n---\n'
  } >> "$file"

  printf '%s%s%s note added to %s%s\n' "$G" "$I_OK" "$N" "${file#"${notes%/notes}"/}" "${private:+ (private)}"
}

# --- outpost update -----------------------------------------------------------

# self_update: moves an install clone (detached on a release tag, no local change) to the
# latest release tag. A dev clone (on a branch) or a modified one is left as it is.
# Sets NEW_TAG to the tag it moved to (empty otherwise).
self_update() {
  local h="$OUTPOST_HOME" latest
  NEW_TAG=""
  if ! git -C "$h" rev-parse --git-dir >/dev/null 2>&1; then
    warn "$h is not a git clone: tool not updated"; return 0
  fi
  if git -C "$h" symbolic-ref -q HEAD >/dev/null; then
    warn "dev clone (on branch $(git -C "$h" symbolic-ref --short HEAD)): tool not updated, the mission gets this working copy"
    return 0
  fi
  if [ -n "$(git -C "$h" status --porcelain)" ]; then
    warn "$h has local changes: tool not updated"; return 0
  fi
  if ! git -C "$h" fetch -q --tags origin 2>/dev/null; then
    warn "could not fetch release tags (offline?): staying on v$VERSION"; return 0
  fi
  latest=$(git -C "$h" tag -l 'v[0-9]*' --sort=-v:refname | head -n 1)
  [ -n "$latest" ] && [ "$latest" != "v$VERSION" ] || return 0
  # Only move forward (the latest tag can be older than an unreleased VERSION bump).
  [ "$(printf '%s\nv%s\n' "$latest" "$VERSION" | sort -V | tail -n 1)" = "$latest" ] || return 0
  git -C "$h" -c advice.detachedHead=false checkout -q "$latest" \
    || { warn "could not check out $latest: staying on v$VERSION"; return 0; }
  NEW_TAG="$latest"
}

cmd_update() {
  local target="" dry=0 fetch=1 notes root args=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run)  dry=1; shift ;;
      --no-fetch) fetch=0; shift ;;
      --verbose|--no-skill|--no-profile) args+=("$1"); shift ;;
      -*)         die "unknown option: $1" ;;
      *)          target="$1"; shift ;;
    esac
  done

  # Which mission: the explicit path (or dry-run name), else the one around the current folder.
  if [ "$dry" = 1 ]; then
    target="${target:-mission}"
    [ -f "$OUTPOST_HOME/.dry-run/$target/.outpost.conf" ] || die "no dry-run mission '$target' (run: outpost init $target --dry-run)"
  elif [ -n "$target" ]; then
    [ -f "$target/.outpost.conf" ] || die "$target is not an outpost mission (no .outpost.conf)"
  else
    notes=$(find_notes_dir) || die "no mission found from $PWD: run inside a mission folder or pass its path"
    root=$(dirname "$notes")
    [ -f "$root/.outpost.conf" ] || die "$root is not an outpost mission (no .outpost.conf)"
    case "$root/" in
      "$OUTPOST_HOME/.dry-run/"*) dry=1; target="${root#"$OUTPOST_HOME/.dry-run/"}" ;;
      *) target="$root" ;;
    esac
  fi

  # 1. The tool. Never in dry-run: a test run must not move the clone.
  if [ "$fetch" = 1 ] && [ "$dry" = 0 ]; then
    self_update
    if [ -n "$NEW_TAG" ]; then
      say "${I_START} ${B}Outpost${N} v$VERSION -> $NEW_TAG"
      # Hand over to the new version, which refreshes the mission with its own code.
      exec "$OUTPOST_HOME/outpost" update --no-fetch "$target" ${args[@]+"${args[@]}"}
    fi
  fi

  # 2. The mission: same code path as init, so a fresh and an updated mission are identical.
  CMD=update
  [ "$dry" = 1 ] && args+=(--dry-run)
  cmd_init "$target" ${args[@]+"${args[@]}"}
}

case "${1:-help}" in
  init) shift; cmd_init "$@" ;;
  update) shift; cmd_update "$@" ;;
  note) shift; cmd_note "$@" ;;
  help|-h|--help) usage ;;
  -v|--version|version) say "$VERSION" ;;
  *) usage >&2; exit 2 ;;
esac

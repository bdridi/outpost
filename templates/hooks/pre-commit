#!/bin/sh
# outpost: relay to the managed hook in <mission>/_outpost (refreshed by `outpost update`).
# Fails closed: no managed hook, no commit.
hook="$(git rev-parse --show-toplevel)/../_outpost/notes/hooks/pre-commit"
if [ ! -f "$hook" ]; then
  echo "outpost: commit blocked, $hook is missing (run 'outpost update')" >&2
  exit 1
fi
exec sh "$hook" "$@"
